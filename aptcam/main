#!/bin/bash
########################################################
## CameraPi by Ben Provenzano III  #####################
########################################################
########################################################

CURL_ARGS="--fail --no-buffer --max-time 3 --silent --retry 3 --retry-all-errors --retry-delay 1"
LOCALHOST="127.0.0.1"
FILES_IP="192.168.1.4"
LDR_SENSOR_PIN="22"
IR_FILTER_PIN="17"
IR_LEDS_PIN="27"

## Read Command-Line Argument
ARG_1="${1//$'\n'/}"

case "$ARG_1" in

boot)
## GPIO Services
systemctl set-environment rpi_ldrpin=$LDR_SENSOR_PIN
systemctl start rpi-ldrdetect
systemctl start rpi-gposerver
## Video RAM disk
mkdir -p /mnt/ramdisk
chmod 777 /mnt/ramdisk
mount -t tmpfs -o size=284m ramdisk /mnt/ramdisk
## Attach flash drive
mkdir -p /media/usb0
mount /dev/sda1 /media/usb0
sleep 5
## Attach server SMB share
if ping -c 1 $FILES_IP > /dev/null 2> /dev/null
then
  systemctl start autofs
  sleep 5
fi
## Google Drive
if [ ! -e "/media/usb0/rclone" ]; then
  echo "flash drive not connected, not starting rclone."
else
  systemctl start rpi-rclone
  sleep 5
fi
## Motion Server
systemctl start rpi-motion.service
## Cameras Cleanup Timer
systemctl start rpi-camcleanup.timer
exit
;;

ir_on)
## IR LEDs Enable Command 
/usr/bin/curl $CURL_ARGS "$LOCALHOST:8770/gpio?pin=$IR_LEDS_PIN&state=HIGH"
sleep 2.5
/usr/bin/curl $CURL_ARGS "$LOCALHOST:8770/gpio?pin=$IR_FILTER_PIN&state=HIGH"
exit
;;

ir_off)
## IR LEDs Disable Command 
/usr/bin/curl $CURL_ARGS "$LOCALHOST:8770/gpio?pin=$IR_LEDS_PIN&state=LOW"
sleep 2.5
/usr/bin/curl $CURL_ARGS "$LOCALHOST:8770/gpio?pin=$IR_FILTER_PIN&state=LOW"
exit
;;

cpusb)
## Copy Videos on USB Drive to Server
rsync -a --progress /media/usb0/cameras/Doorway/* /mnt/smb/Cameras/Doorway/
echo "videos can be found at '//files/Cameras/Doorway'"
read -p "delete videos from USB drive? (y/n) " -n 1 -r
echo
if [[ $REPLY =~ ^[yY]$ ]]
then
  rm -rfv /media/usb0/cameras/Doorway
  mkdir -p /media/usb0/cameras/Doorway
  chown -R motion:motion /media/usb0/cameras/Doorway
  chmod -R 777 /media/usb0/cameras/Doorway
fi
exit
;;
    
*)
echo "CameraPi"
echo " by Ben Provenzano III"
echo " "
echo "cpusb - copy videos on USB drive to server"
echo " "
echo "enter a valid command argument."
exit 1
;;
esac   
