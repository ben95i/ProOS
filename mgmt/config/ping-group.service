## Lets every group use ping sockets, so non-root users can ping hosts.
## A sysctl.conf setting is not enough here: systemd-sysctl is skipped in an
## LXC, whose /proc/sys is read-only apart from /proc/sys/net.
[Unit]
Description=Allow non-root users to ping hosts

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'echo "0 65535" > /proc/sys/net/ipv4/ping_group_range'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
