[Unit]
Description=Runs Hourly Script - Shutdown/Reboot
RequiresMountsFor=/mnt/ramdisk
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
StandardOutput=journal
StandardError=journal
ExecStart=/bin/true
ExecStop=/usr/bin/hourly.sh
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target