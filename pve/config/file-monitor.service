[Unit]
Description=File Monitor Script Trigger
After=local-fs.target network.target
RequiresMountsFor=/mnt/ramdisk

[Service]
User=root
Type=simple

# systemd defaults to 0022, which would create the output files without
# group write. The tmpfs is mounted setgid, so the GROUP comes for free --
# the OWNER does not: root creates them, so file-monitor.sh chowns each.
UMask=0002

ExecStart=/usr/bin/file-monitor.sh

LogLevelMax=notice
# always: if inotifywait dies for any reason the script can exit
# cleanly, and on-failure would leave the monitor permanently dead.
Restart=always
RestartSec=5

# stop the watcher AND every command it spawned
KillMode=control-group
KillSignal=SIGTERM
TimeoutStopSec=30

# each job writes to its own file in /mnt/ramdisk (outputRoutes in
# file-monitor.sh), keep the journal quiet
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
