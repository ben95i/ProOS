[Unit]
Description=File Monitor Script Trigger
After=local-fs.target network.target
RequiresMountsFor=/mnt/ramdisk

[Service]
User=root
Type=simple

# systemd defaults to 0022, which would create the log without group
# write. The tmpfs is mounted setgid, so the GROUP comes for free --
# the OWNER does not: root creates it, so it needs an explicit chown.
UMask=0002

# runs after the tmpfs is mounted, before the watcher starts.
ExecStartPre=/bin/sh -c 'touch /mnt/ramdisk/sysout.txt && chown tank:shared /mnt/ramdisk/sysout.txt'
ExecStartPre=-/bin/sh -c '/usr/bin/apicmds.sh clearlog /mnt/ramdisk >> /mnt/ramdisk/sysout.txt 2>&1'
ExecStart=/usr/bin/file-monitor.sh

LogLevelMax=notice
# always: if inotifywait dies for any reason the script can exit
# cleanly, and on-failure would leave the monitor permanently dead.
Restart=always
RestartSec=5

# stop the watcher AND every command it spawned
KillMode=control-group
KillSignal=SIGTERM
TimeoutStopSec=30

# jobs write to /mnt/ramdisk/sysout.txt, keep the journal quiet
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
