[Unit]
Description=minimotion RTSP motion recorder
# The RAM disk must be mounted first: otherwise temp_dir would be created
# on the overlay root and recordings would fill the Pi's memory.
Requires=rpi-ramdisk.service
After=rpi-ramdisk.service
# remote-fs.target: try to mount the SMB shares first (copies still check each time).
After=rpi-rtspcam.service network.target remote-fs.target
Wants=rpi-rtspcam.service

[Service]
ExecStart=/opt/rpi/minimotion -c /opt/rpi/minimotion.conf
Restart=always
RestartSec=5
Nice=5
# On SIGTERM each camera finalises its movie, then copies get up to 20 s.
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
