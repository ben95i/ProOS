[Unit]
Description=Camera Cleanup (keeps camera folders under their size limits)
## Every setting is in /etc/camcleanup.conf, copied by a module's installer
## from its config/camcleanup.conf. A Pi without one never runs the cleanup.
ConditionPathExists=/etc/camcleanup.conf

[Service]
Type=oneshot
RemainAfterExit=no
ExecStart=-/opt/rpi/camcleanup.sh /etc/camcleanup.conf
