[Unit]
Description=IMX462 camera -> hardware H.264 -> RTSP on port 8554 (/cam) 90 degree rotated
After=network.target
Before=rpi-motion.service

[Service]
Type=simple
User=root
# Wait for the Pi's ISP driver so libcamera finds the camera at boot
ExecStartPre=/bin/sh -c 'for i in $(seq 30); do grep -qs bcm2835-isp /sys/class/video4linux/*/name && exit 0; sleep 1; done; exit 1'
ExecStart=/opt/rpi/rtspcam -w ${rpi_imxout_w} -h ${rpi_imxout_h} -f ${rpi_imxfps} -i ${rpi_imxfps} -b ${rpi_imxbps} -s ${rpi_imxsm} -r ${rpi_imxrotate}
Restart=always
RestartSec=5

# Hardening
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
