[Custom Commands][net.local.sh-2.desktop]
Exec=sh -c "curl 'http://automate.home/api?arg=lrlightsoff&var=&action=main'"
Name=Lights Off

[Custom Commands][net.local.sh-3.desktop]
Exec=sh -c "curl 'http://automate.home/api?var=hifitoggle&arg=lrxmit&action=main'"
Name=Toggle Stereo Power

[Custom Commands][net.local.sh.desktop]
Exec=sh -c "curl 'http://automate.home/api?arg=lrlightson&var=&action=main'"
Name=Lights On

[Custom Commands][net.local.toggle_split_screen.sh.desktop]
Exec=/opt/scripts/toggle_split_screen.sh
Name=Toggle Split Screen

