# /etc/auto.files: autofs indirect map for the files server's SMB shares
# (its SFTP mount is in /etc/auto.sftp)
# Each share is mounted on /mnt/SMB/<key> on first access and unmounted after
# 10 idle minutes (--timeout in /etc/auto.master.d/files.autofs). A share that
# fails to mount is retried on the next access after negative_timeout
# (/etc/autofs.conf).
# Must not be executable, or autofs runs it as a program map.
#
# <key>     <options>  <location>
#
Data      -fstype=cifs,rw,credentials=/root/smb.credentials,iocharset=utf8,vers=3.0,soft,echo_interval=5,handletimeout=5000,uid=1000,gid=1000,dir_mode=0700   ://files.home/Data
Media     -fstype=cifs,rw,credentials=/root/smb.credentials,iocharset=utf8,vers=3.0,soft,echo_interval=5,handletimeout=5000,uid=1000,gid=1000,dir_mode=0700   ://files.home/Media
Scratch   -fstype=cifs,rw,credentials=/root/smb.credentials,iocharset=utf8,vers=3.0,soft,echo_interval=5,handletimeout=5000,uid=1000,gid=1000,dir_mode=0700   ://files.home/Scratch
Cameras   -fstype=cifs,rw,credentials=/root/smb.credentials,iocharset=utf8,vers=3.0,soft,echo_interval=5,handletimeout=5000,uid=1000,gid=1000,dir_mode=0700   ://files.home/Cameras
Regions   -fstype=cifs,rw,credentials=/root/smb.credentials,iocharset=utf8,vers=3.0,soft,echo_interval=5,handletimeout=5000,uid=1000,gid=1000,dir_mode=0700   ://files.home/Regions
Games     -fstype=cifs,rw,credentials=/root/smb.credentials,iocharset=utf8,vers=3.0,soft,echo_interval=5,handletimeout=5000,uid=1000,gid=1000,dir_mode=0700   ://files.home/Games
MP3s      -fstype=cifs,rw,credentials=/root/smb.credentials,iocharset=utf8,vers=3.0,soft,echo_interval=5,handletimeout=5000,uid=1000,gid=1000,dir_mode=0700   ://files.home/MP3s
External  -fstype=cifs,rw,credentials=/root/smb.credentials,iocharset=utf8,vers=3.0,soft,echo_interval=5,handletimeout=5000,uid=1000,gid=1000,dir_mode=0700   ://files.home/External
GSync     -fstype=cifs,rw,credentials=/root/smb.credentials,iocharset=utf8,vers=3.0,soft,echo_interval=5,handletimeout=5000,uid=1000,gid=1000,dir_mode=0700   ://files.home/GSync
