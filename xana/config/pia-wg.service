[Unit]
Description=PIA WireGuard tunnel
Requires=pia-wg-firewall.service
After=pia-wg-firewall.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/pia-wg-connect
ExecStopPost=/usr/local/sbin/pia-wg-disconnect
Restart=on-failure
RestartSec=30
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
