#!/usr/bin/env bash
# Run by pia-wg-watchdog.timer: (re)start the tunnel if it's down or the
# WireGuard handshake is stale (server gone, key expired, network change).
source /etc/pia-wg/pia-wg.conf
IF=pia
MAX_AGE=${MAX_HANDSHAKE_AGE:-300}

state=$(systemctl is-active pia-wg.service)
case $state in
  active) ;;
  activating|deactivating|reloading) exit 0 ;;   # connect in progress / auto-restart pending
  *) echo "pia-wg is $state, starting"; systemctl start --no-block pia-wg.service; exit 0 ;;
esac

if [[ ${PIA_PF:-no} == yes ]] && ! systemctl is-active --quiet pia-wg-pf.service; then
  case $(systemctl is-active pia-wg-pf.service) in
    activating|deactivating) ;;
    *) echo "pia-wg-pf not running, starting"; systemctl start --no-block pia-wg-pf.service ;;
  esac
fi

hs=$(wg show "$IF" latest-handshakes 2>/dev/null | awk '{print $2}')
age=$(( $(date +%s) - ${hs:-0} ))
if [[ -z $hs || $hs -eq 0 || $age -gt $MAX_AGE ]]; then
  echo "handshake stale (${age}s), reconnecting"
  systemctl restart --no-block pia-wg.service
fi
