#!/usr/bin/env bash
# Get a token, pick a server, register a fresh WireGuard key, bring up "pia".
set -euo pipefail
umask 077
export LC_ALL=C
cd /
source /etc/pia-wg/pia-wg.conf

IF=pia
CA=/etc/pia-wg/ca.rsa.4096.crt
WGCONF=/etc/wireguard/$IF.conf
TOKEN_URL=https://www.privateinternetaccess.com/api/client/v2/token
SERVERLIST_URL=https://serverlist.piaservers.net/vpninfo/servers/v6

log() { echo "$*" >&2; }
die() { log "ERROR: $*"; exit 1; }
# The kill switch only lets user 'piawg' reach PIA's API outside the tunnel.
as_pia() { runuser -u piawg -- "$@"; }

/usr/local/sbin/pia-wg-disconnect   # clean slate; kill switch keeps blocking meanwhile

log "Authenticating as $PIA_USER"
# Password goes in via stdin so it never shows up in the process list.
token=$(printf '%s' "$PIA_PASS" |
        as_pia curl -fsS -L --max-time 20 \
          -F "username=$PIA_USER" -F "password=<-" "$TOKEN_URL" |
        jq -r '.token // empty') || die "token request failed (network/DNS?)"
[[ -n $token ]] || die "login rejected, check PIA_USER/PIA_PASS"

log "Fetching server list"
serverlist=$(as_pia curl -fsS --max-time 20 "$SERVERLIST_URL" | sed -n 1p) ||
  die "server list download failed"
[[ ${#serverlist} -gt 1000 ]] || die "server list looks empty"

# With port forwarding on, only regions that support it are candidates.
pf_only=false
[[ ${PIA_PF:-no} == yes ]] && pf_only=true

region=$PIA_REGION
if [[ $region == auto ]]; then
  log "Measuring latency to all regions$($pf_only && echo ' that support port forwarding')"
  # fastest first; the server pick below falls through to the next region if needed
  candidates=$(jq -r --argjson pf "$pf_only" '.regions[]
                  | select(.offline != true and .geo != true)
                  | select(($pf | not) or .port_forward == true)
                  | "\(.servers.meta[0].ip) \(.id)"' <<<"$serverlist" |
    as_pia xargs -P 20 -n 2 sh -c \
      't=$(curl -o /dev/null -s --connect-timeout 1 -w "%{time_connect}" "http://$0:443") \
         && echo "$t $1"; exit 0' |
    sort -n | awk '{print $2}')
  [[ -n $candidates ]] || die "no region answered within 1s"
else
  if $pf_only; then
    [[ $(jq -r --arg r "$region" '.regions[] | select(.id == $r) | .port_forward' <<<"$serverlist") == true ]] ||
      die "region '$region' does not support port forwarding (set PIA_REGION=auto or pick one marked port-forward in pia-wg-regions)"
  fi
  candidates=$region
fi

# Servers whose port forwarding API failed recently (written by pia-wg-portforward)
# are skipped for 6 hours.
mkdir -p /run/pia-wg
bad=/run/pia-wg/pf-bad-servers
recent_bad=$(awk -v now="$(date +%s)" '$2 > now - 21600 {print $1}' "$bad" 2>/dev/null || true)

pick_server() {   # $1 = region, $2 = "filter" to skip recently bad servers
  jq -r --arg r "$1" '.regions[] | select(.id == $r) | .servers.wg[] | "\(.ip) \(.cn)"' <<<"$serverlist" |
    if [[ ${2:-} == filter ]] && [[ -n $recent_bad ]]; then
      awk 'NR==FNR {skip[$1]; next} !($2 in skip)' <(printf '%s\n' "$recent_bad") -
    else
      cat
    fi | shuf -n1
}

wg_ip=""; wg_cn=""
for r in $candidates; do
  read -r wg_ip wg_cn < <(pick_server "$r" filter) || true
  if [[ -n $wg_ip ]]; then region=$r; break; fi
done
if [[ -z $wg_ip && $PIA_REGION != auto ]]; then
  log "All servers in $PIA_REGION recently failed port forwarding; trying one anyway"
  read -r wg_ip wg_cn < <(pick_server "$PIA_REGION") || true
fi
[[ -n $wg_ip ]] || die "region '$region' not found or has no usable WireGuard servers (see pia-wg-regions)"

priv=$(wg genkey)
pub=$(wg pubkey <<<"$priv")

log "Registering key with $wg_cn ($wg_ip), region $region"
# Token/pubkey passed via a curl config on stdin, keeping the token out of ps too.
resp=$(printf 'data-urlencode = "pt=%s"\ndata-urlencode = "pubkey=%s"\n' "$token" "$pub" |
       as_pia curl -fsS -G --max-time 20 -K - \
         --connect-to "$wg_cn::$wg_ip:" --cacert "$CA" \
         "https://$wg_cn:1337/addKey") || die "addKey request failed"
[[ $(jq -r .status <<<"$resp") == OK ]] || die "addKey refused: $resp"

peer_ip=$(jq -r .peer_ip <<<"$resp")
server_key=$(jq -r .server_key <<<"$resp")
server_port=$(jq -r .server_port <<<"$resp")
dns=$(jq -r '.dns_servers[0]' <<<"$resp")
server_vip=$(jq -r '.server_vip // empty' <<<"$resp")

# Details pia-wg-portforward needs; a new connection invalidates any old PF signature.
rm -f /run/pia-wg/pf-signature.json /run/pia-wg/pf-failures
printf 'PF_TOKEN=%q\nPF_HOST=%q\nPF_GATEWAY=%q\nPF_VIP=%q\n' \
  "$token" "$wg_cn" "$wg_ip" "$server_vip" > /run/pia-wg/pf.env

cat > "$WGCONF" <<EOF
# Generated by pia-wg-connect — overwritten on every reconnect.
[Interface]
PrivateKey = $priv
Address = $peer_ip
FwMark = 51820

[Peer]
PublicKey = $server_key
Endpoint = $wg_ip:$server_port
AllowedIPs = 0.0.0.0/0
PersistentKeepalive = 25
EOF

wg-quick up "$IF"

# All DNS -> PIA's resolver through the tunnel; router DNS and DoT blocked.
/usr/local/sbin/pia-wg-dns up "$dns"

mkdir -p /run/pia-wg
printf 'region=%s\nserver=%s (%s:%s)\ntunnel_ip=%s\ndns=%s\nsince=%s\n' \
  "$region" "$wg_cn" "$wg_ip" "$server_port" "$peer_ip" "$dns" "$(date -Is)" > /run/pia-wg/status

for _ in $(seq 20); do
  hs=$(wg show "$IF" latest-handshakes | awk '{print $2}')
  if [[ ${hs:-0} -gt 0 ]]; then log "Connected to $region via $wg_cn, tunnel IP $peer_ip"; exit 0; fi
  sleep 1
done
die "no WireGuard handshake with $wg_cn"
