#!/bin/bash
########################################################
## LEDwall main script by Ben Provenzano III ###########
########################################################
########################################################

## Arduino's Serial Port
ARDUINO_PORT="ttyAMA0"

CURL_ARGS="--fail --no-buffer --max-time 3 --silent --retry 3 --retry-all-errors --retry-delay 1"
LOCALHOST="127.0.0.1"

## Read Command-Line Arguments
ARG_1="${1//$'\n'/}"
ARG_2="${2//$'\n'/}"

ZTERM_COM() {
  local CMD_DATA="$1"
  /usr/bin/ztermcom $CMD_DATA
}

FADECANDY_API() {
  ## Fadecandy API Hook
  if [ "$ARG_1" == "fc_leds" ]; then
    CMD_SEP="-"
    LEVEL_IN=${ARG_2#*$CMD_SEP}
    if [[ "$LEVEL_IN" == "" ]]; then
      /usr/bin/curl $CURL_ARGS $LOCALHOST:7892/brightness
    else
      /usr/bin/curl $CURL_ARGS $LOCALHOST:7892/set?b=$LEVEL_IN
    fi
    exit
  fi
  LED_OUT=$(/opt/rpi/leds "$ARG_1" "$ARG_2")
  echo "$LED_OUT"
}

case "$ARG_1" in

boot)
## External Serial COM
ln -sf /dev/$ARDUINO_PORT /dev/zterm-tty
ZTERM_COM "i"
## WiFi Toggle Switch
systemctl start rpi-wifiswitch
## LED Controller
/opt/rpi/leds start
## Flash LED
/usr/bin/python3 - <<END
import time
import RPi.GPIO as GPIO
GPIO.setwarnings(False)
GPIO.setmode(GPIO.BCM)
GPIO_PIN = 12
GPIO.setup(GPIO_PIN, GPIO.OUT)
GPIO.output(GPIO_PIN, True)
time.sleep(0.5)
GPIO.output(GPIO_PIN, False)
GPIO.cleanup()
quit()
END
exit
;;

apdled-on)
## Turn WiFi LED On
/usr/bin/python3 - <<END
import RPi.GPIO as GPIO
GPIO.setwarnings(False)
GPIO.setmode(GPIO.BCM)
GPIO_PIN = 26
GPIO.setup(GPIO_PIN, GPIO.OUT)
GPIO.output(GPIO_PIN, True)
quit()
END
exit
;;

apdled-off)
## Turn WiFi LED Off
/usr/bin/python3 - <<END
import RPi.GPIO as GPIO
GPIO.setwarnings(False)
GPIO.setmode(GPIO.BCM)
GPIO_PIN = 26
GPIO.setup(GPIO_PIN, GPIO.OUT)
GPIO.output(GPIO_PIN, False)
GPIO.cleanup()
quit()
END
exit
;;

whtledon)
## White Front LED On
touch /tmp/whtled.save
/usr/bin/python3 - <<END
import RPi.GPIO as GPIO
GPIO.setwarnings(False)
GPIO.setmode(GPIO.BCM)
GPIO_PIN = 12
GPIO.setup(GPIO_PIN, GPIO.OUT)
GPIO.output(GPIO_PIN, True)
quit()
END
exit
;;

whtledoff)
## White Front LED Off
rm -f /tmp/whtled.save
/usr/bin/python3 - <<END
import RPi.GPIO as GPIO
GPIO.setwarnings(False)
GPIO.setmode(GPIO.BCM)
GPIO_PIN = 12
GPIO.setup(GPIO_PIN, GPIO.OUT)
GPIO.output(GPIO_PIN, False)
GPIO.cleanup()
quit()
END
exit
;;

whtled)
## White Front LED Toggle
if [ -e /tmp/whtled.save ]; then
rm -f /tmp/whtled.save
/usr/bin/python3 - <<END
import RPi.GPIO as GPIO
GPIO.setwarnings(False)
GPIO.setmode(GPIO.BCM)
GPIO_PIN = 12
GPIO.setup(GPIO_PIN, GPIO.OUT)
GPIO.output(GPIO_PIN, False)
GPIO.cleanup()
quit()
END
else
/usr/bin/python3 - <<END
import RPi.GPIO as GPIO
GPIO.setwarnings(False)
GPIO.setmode(GPIO.BCM)
GPIO_PIN = 12
GPIO.setup(GPIO_PIN, GPIO.OUT)
GPIO.output(GPIO_PIN, True)
quit()
END
fi
exit
;;

pc_power)
## PC Power Trigger
/usr/bin/python3 - <<END
import time
import RPi.GPIO as GPIO
GPIO.setwarnings(False)
GPIO.setmode(GPIO.BCM)
GPIO_PIN = 16
GPIO.setup(GPIO_PIN, GPIO.OUT)
GPIO.output(GPIO_PIN, True)
time.sleep(0.3)
GPIO.output(GPIO_PIN, False)
GPIO.cleanup()
quit()
END
exit
;;

## Pass command to external serial port
extcom)
ZTERM_COM "$ARG_2"
exit
;;

serialmon)
/opt/rpi/arduino-cli monitor -p /dev/$ARDUINO_PORT \
  -b arduino:avr:uno --config 9600
exit
;;

update-fw)
## Update Arduino over USB
rm -rf /opt/fw-build
mkdir -p /opt/fw-build
arduino-cli -v compile --fqbn arduino:avr:uno \
  /opt/rpi/firmware.ino --build-path /opt/fw-build
arduino-cli -v upload -p /dev/$ARDUINO_PORT \
  --fqbn arduino:avr:uno --input-dir /opt/fw-build
LOCALCOM "i"
exit
;;

*)
  if [ "$ARG_1" == "" ]; then
    echo "Enter valid command."
    exit
  fi
  FADECANDY_API
  exit
  ;;
esac

