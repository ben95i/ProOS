#!/bin/bash
########################################################
## LEDwall main script by Ben Provenzano III ###########
########################################################
########################################################

CURL_ARGS="--fail --no-buffer --max-time 3 --silent --retry 3 --retry-all-errors --retry-delay 1"
ARDUINO_PORT="ttyAMA0"
LOCALHOST="127.0.0.1"
WHITE_LED_PIN="12"
FRONT_BTN_PIN="13"
FRONT_LED_PIN="26"
PC_POWER_PIN="16"

## Read Command-Line Arguments
ARG_1="${1//$'\n'/}"
ARG_2="${2//$'\n'/}"

ZTERM_COM() {
  /usr/bin/ztermcom "$1"
}

FADECANDY_API() {
  ## Fadecandy API Hook
  if [ "$ARG_1" == "fc_leds" ]; then
    CMD_SEP="-"
    LEVEL_IN=${ARG_2#*$CMD_SEP}
    if [[ "$LEVEL_IN" == "" ]]; then
      /usr/bin/curl $CURL_ARGS $LOCALHOST:7892/brightness
    else
      /usr/bin/curl $CURL_ARGS $LOCALHOST:7892/set?b=$LEVEL_IN
    fi
    exit
  fi
  LED_OUT=$(/opt/rpi/leds "$ARG_1" "$ARG_2")
  echo "$LED_OUT"
}

case "$ARG_1" in

boot)
## External Serial COM
ln -sf /dev/$ARDUINO_PORT /dev/zterm-tty
ZTERM_COM "i"
## GPIO Services
systemctl set-environment rpi_gpipin_1=$FRONT_BTN_PIN
systemctl set-environment rpi_gpicmd_1=front_btn
systemctl start rpi-pinmon-1
systemctl start rpi-gposerver
## LED Controller
/opt/rpi/leds start
exit
;;

front_btn)
## Front Panel Button Press
/usr/bin/curl $CURL_ARGS "$LOCALHOST:8770/gpio?pin=$FRONT_LED_PIN&state=HIGH"
/opt/rpi/leds shuffle
/usr/bin/curl $CURL_ARGS "$LOCALHOST:8770/gpio?pin=$FRONT_LED_PIN&state=LOW"
exit
;;

whtledon)
## White Front LED On
/usr/bin/curl $CURL_ARGS "$LOCALHOST:8770/gpio?pin=$WHITE_LED_PIN&state=HIGH"
exit
;;

whtledoff)
## White Front LED Off
/usr/bin/curl $CURL_ARGS "$LOCALHOST:8770/gpio?pin=$WHITE_LED_PIN&state=LOW"
exit
;;

whtled)
## White Front LED Toggle
/usr/bin/curl $CURL_ARGS "$LOCALHOST:8770/gpio?pin=$WHITE_LED_PIN&state=TOGGLE"
exit
;;

pc_power)
## PC Power Trigger
/usr/bin/curl $CURL_ARGS "$LOCALHOST:8770/gpio?pin=$PC_POWER_PIN&state=HIGH"
sleep 0.30
/usr/bin/curl $CURL_ARGS "$LOCALHOST:8770/gpio?pin=$PC_POWER_PIN&state=LOW"
exit
;;

## Pass command to external serial port
extcom)
ZTERM_COM "$ARG_2"
exit
;;

serialmon)
/opt/rpi/arduino-cli monitor -p /dev/$ARDUINO_PORT \
  -b arduino:avr:uno --config 9600
exit
;;

update-fw)
## Update Arduino over USB
rm -rf /opt/fw-build
mkdir -p /opt/fw-build
arduino-cli -v compile --fqbn arduino:avr:uno \
  /opt/rpi/firmware.ino --build-path /opt/fw-build
arduino-cli -v upload -p /dev/$ARDUINO_PORT \
  --fqbn arduino:avr:uno --input-dir /opt/fw-build
LOCALCOM "i"
exit
;;

*)
if [ "$ARG_1" == "" ]; then
  echo "Enter valid command."
  exit
fi
FADECANDY_API
exit
;;
esac

